### Method

```python
"""scripts/agent/__init__.py

Agent framework: core orchestration and concern modules.

Exports:
    Orchestrator: Main orchestrator class (thin composition facade after refactor)
    TurnCoordinator: Tool-loop coordination for one agent turn
    WorkflowEngineAdapter: Workflow engine integration (approval, halt, activation)
    BgTaskMonitor: Background task monitoring and failure threshold handling
    LlmTurnExecutor: LLM streaming and inner tool-call loop
    AuditEventEmitter: Audit event construction and emission
    ConversationStateManager: Conversation history manipulation
"""

from agent.audit_event_emitter import AuditEventEmitter
from agent.bg_task_monitor import BgTaskMonitor
from agent.conversation_state_manager import ConversationStateManager
from agent.llm_turn_executor import LlmTurnExecutor
from agent.turnd_coordinator import TurnCoordinator
from agent.workflow_engine_adapter import WorkflowEngineAdapter

__all__ = [
    "Orchestrator",
    "TurnCoordinator",
    "WorkflowEngineAdapter",
    "BgTaskMonitor",
    "LlmTurnExecutor",
    "AuditEventEmitter",
    "ConversationStateManager",
]
```

