{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContractManifest",
  "description": "Envelope and per-manifest entry shapes for every generated contract manifest under registry/manifests/ (ADR-015 generation extension, REQ-005/REQ-006/REQ-007). Generated by tools/generate_reference_table.py --manifests; never hand-edit. Entries are sorted by their natural key by the generator (byte-stable committed YAML).",
  "type": "object",
  "required": ["manifest", "version", "generated_by", "sources", "entries"],
  "additionalProperties": false,
  "properties": {
    "manifest": {
      "type": "string",
      "enum": [
        "tool_ownership",
        "mcp_endpoints",
        "eventbus_route_roles",
        "db_schema_versions",
        "config_ownership",
        "health_contracts",
        "invariant_coverage",
        "agent_api",
        "eventbus_api",
        "memory_api"
      ],
      "description": "Manifest identity — one of the seven REQ-006 contract manifests or the three rendering manifests (agent_api/eventbus_api/memory_api). Deferred REQ-007 names (component_mandatoriness, adr_authority, architecture_assumptions) are added by their own plans."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Manifest format version; bumped only with a coordinated schema change."
    },
    "generated_by": {
      "const": "tools/generate_reference_table.py",
      "description": "The sole generator of committed manifests."
    },
    "sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Repo-relative live-code (or docs) files the manifest was generated from; re-read by the manifest<->source drift check."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Optional generation timestamp. Never written by the generator: committed YAML must be byte-stable (doc 14 git-diff freshness step), and it is excluded from drift comparison."
    },
    "deferred": {
      "type": "boolean",
      "default": false,
      "description": "REQ-007 explicit deferred-state marker: a manifest whose source does not exist yet validates with zero entries and is not required by the drift pipeline."
    },
    "entries": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Manifest rows; per-manifest entry shape is enforced by the manifest const branch in allOf. Each entry is keyed by a stable natural key."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "deferred": { "const": true } },
        "required": ["deferred"]
      },
      "then": { "properties": { "entries": { "minItems": 0 } } },
      "else": { "properties": { "entries": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "manifest": { "const": "tool_ownership" } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["tool", "server", "port"],
              "additionalProperties": false,
              "properties": {
                "tool": { "type": "string", "minLength": 1, "description": "Natural key: TOOL_LIST tool name." },
                "server": { "type": "string", "minLength": 1, "description": "Owning MCP server config key." },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest": { "const": "mcp_endpoints" } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["server", "port", "tools"],
              "additionalProperties": false,
              "properties": {
                "server": { "type": "string", "minLength": 1, "description": "Natural key: MCP server config key." },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "tools": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "uniqueItems": true,
                  "description": "Tool names from the TOOL_LIST scan (empty when the server publishes none)."
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest": { "const": "eventbus_route_roles" } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["route", "roles"],
              "additionalProperties": false,
              "properties": {
                "route": { "type": "string", "pattern": "^/[A-Za-z0-9/_*]*$", "description": "Natural key: route path from _ROUTE_ROLE_MAP." },
                "roles": {
                  "type": "array",
                  "items": { "type": "string", "enum": ["ADMIN", "CONSUMER", "MONITORING", "OPERATOR", "PUBLISHER"] },
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "Role names granted for the route, sorted."
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest": { "const": "db_schema_versions" } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["kind", "name"],
              "oneOf": [
                {
                  "additionalProperties": false,
                  "required": ["kind", "name", "config_key", "in_agent_toml"],
                  "properties": {
                    "kind": { "const": "db_path" },
                    "name": { "type": "string", "minLength": 1, "description": "Natural key: DB file name, e.g. content.sqlite." },
                    "config_key": { "type": "string", "minLength": 1, "description": "DbConfig field name, e.g. content_db_path." },
                    "in_agent_toml": { "type": "boolean", "description": "Whether the path is set in config/agent.toml." }
                  }
                },
                {
                  "additionalProperties": false,
                  "required": ["kind", "name", "source", "version", "content_hash"],
                  "properties": {
                    "kind": { "const": "schema" },
                    "name": { "type": "string", "minLength": 1, "description": "Natural key: schema identity, e.g. eventbus or workflow." },
                    "source": { "type": "string", "minLength": 1, "description": "Repo-relative schema source file." },
                    "version": {
                      "type": ["integer", "string"],
                      "description": "Version marker: PRAGMA user_version (integer) or WORKFLOW_SCHEMA_VERSION (string)."
                    },
                    "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the schema source text." }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest": { "const": "config_ownership" } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["field", "section", "hot_reloadable", "validator"],
              "additionalProperties": false,
              "properties": {
                "field": { "type": "string", "minLength": 1, "description": "Natural key: config field name from CONFIG_FIELD_REGISTRY." },
                "section": { "type": "string", "minLength": 1, "description": "Registry section_path, e.g. llm." },
                "hot_reloadable": { "type": "boolean" },
                "validator": { "type": ["string", "null"], "description": "Validator function name, or null when the field has none." }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest": { "const": "health_contracts" } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["server", "checks", "disposition"],
              "additionalProperties": false,
              "properties": {
                "server": { "type": "string", "minLength": 1, "description": "Natural key: MCP server key from posture_contract.REQUIRED_CHECK_IDS." },
                "checks": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "Required posture check ids, sorted."
                },
                "disposition": { "type": "string", "enum": ["fail-fast", "fail-closed"], "description": "ADR-004 failure disposition cited by the matrix rows." }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "manifest": { "const": "invariant_coverage" } }, "required": ["manifest"] },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["invariant", "adr", "gate", "timing", "status"],
              "additionalProperties": false,
              "properties": {
                "invariant": { "type": "string", "minLength": 1, "description": "Natural key: invariant id cell from the adr_01_index.md matrix, e.g. INV-07, INV-10." },
                "adr": { "type": "string", "pattern": "^ADR-[0-9]{3}$" },
                "gate": { "type": "string", "minLength": 1 },
                "timing": { "type": "string", "minLength": 1 },
                "status": { "type": "string", "enum": ["Confirmed", "Partial", "Manual", "Not verified"], "description": "Coverage state token from the Verification Status cell (doc 01 vocabulary)." },
                "cited": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 },
                  "description": "Cited test/file node ids parsed from the Verification Status cell."
                },
                "cadence": { "type": "string", "minLength": 1, "description": "Cadence: field, present on Manual/Partial rows." },
                "expected_evidence": { "type": "string", "minLength": 1, "description": "Expected evidence: field, present on Manual/Partial rows." },
                "exception": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "description": "Exception: id, present when an approved exception is recorded (grammar shared with tools/check_adr_invariant_matrix.py)." }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "manifest": { "enum": ["agent_api", "eventbus_api", "memory_api"] } },
        "required": ["manifest"]
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "type": "object",
              "required": ["file", "name", "kind", "signature", "summary"],
              "additionalProperties": false,
              "properties": {
                "file": { "type": "string", "minLength": 1, "description": "Repo-relative source file; part of the composite natural key (file, name)." },
                "name": { "type": "string", "minLength": 1, "description": "Public top-level class or function name." },
                "kind": { "type": "string", "enum": ["class", "function", "async function"] },
                "signature": { "type": "string", "minLength": 1, "description": "Rendered signature text (class X / [async] def name(args) -> returns)." },
                "summary": { "type": "string", "description": "First docstring line; an em dash when the symbol has no docstring." }
              }
            }
          }
        }
      }
    }
  ]
}
